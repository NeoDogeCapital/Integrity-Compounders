# Integrity Compounders — environment template
# Copy this file to ".env" and fill in the real values from your Windows machine's .env.
# NEVER commit the real .env (it is gitignored). Transfer the real values securely
# (AirDrop the .env file, a password manager, or copy/paste each line).

# ── Supabase (single source of truth — same project on every device) ──────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Postgres connection string (Supabase → Project Settings → Database → Connection string, URI)
DATABASE_URL=postgresql://postgres:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ── Anthropic / Claude API (pillar scoring + memos) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
